# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# FRONTEND (Vite uses VITE_* vars at build time)
# ---------------------------------------------------------------------------

# VITE_PAYSTACK_PUBLIC_KEY: Public key from your Paystack dashboard
# (Settings -> API Keys & Webhooks). Use a TEST key for development.
# Leave empty to run the checkout in local test mode (no real charge).
VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# VITE_API_BASE_URL: Base URL of the backend API (see API_CONTRACT.md).
# When set, the storefront:
#   - reads products from  GET  {base}/api/products
#   - creates orders on    POST {base}/api/orders
#   - polls order status   GET  {base}/api/orders/:orderId
#   - signs customers in   POST {base}/api/auth/customer/login
#   - signs admins in      POST {base}/api/auth/login
# When empty, the app runs fully in local demo mode (bundled data + simulated
# payments, references prefixed LOCAL-). Nothing is charged.
VITE_API_BASE_URL="https://api.example.com"

# ---------------------------------------------------------------------------
# BACKEND (server-side only — never expose these to the frontend)
# ---------------------------------------------------------------------------

# Paystack secret key used to verify transactions server-side
# (https://api.paystack.co/transaction/verify/:reference).
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# JWT_SECRET: used to sign admin + customer session tokens issued by the API.
JWT_SECRET="change-me-to-a-long-random-string"

# DATABASE_URL: connection string for the backend's database.
# Any engine is fine — see docs/BACKEND_SETUP.md for the schema sketch.
DATABASE_URL="postgres://user:pass@localhost:5432/ib_anasa"

# PORT: which port the API server listens on when deployed (Cloud Run injects it).
PORT="8080"

# CORS_ORIGIN: comma-separated allowed origins for the API.
# This must include the storefront origin (Netlify/Cloud Run URL).
CORS_ORIGIN="https://your-store.netlify.app"

# Optional seed for the default admin account (see docs/BACKEND_SETUP.md).
ADMIN_EMAIL="admin@ibanasawears.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Store Admin"